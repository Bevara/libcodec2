{
    "name": "libcodec2",
    "description": "Codec 2 low-bitrate speech decoder",
    "filters":["codec2dec"],
    "help": "This filter decodes Codec 2 speech files (.c2) using libcodec2. Output is always 8 kHz mono.",
    "support": [
        "audio"
    ],
    "sources":"https://bevara.ddns.net/sources/libcodec2.accessor",
    "filter_source":{
        "codec2dec" : "dec_codec2.c"
    },
    "extension":{
      "c2" : "audio"
    },
    "using": ["solver_minimal_1", "solver_1"],
    "patents": {
        "status": "royalty-free",
        "note": "Codec 2",
        "checked": "2026-10-16"
    }
}
